# Same Supabase project as the frontend's VITE_SUPABASE_URL/VITE_SUPABASE_ANON_KEY (see ../.env.example).
# Required for /api/worlds (online saves) — without them the server still starts (live multiplayer
# without saves works) but every /api/worlds route returns 401.
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional, defaults shown
# PORT=3001
# DATA_DIR=./data/worlds
